---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BakeStory from "./BakeStory.astro";
import type { LoadedBake } from "../../lib/bakes";

interface Props {
  bake: LoadedBake;
}

const { bake } = Astro.props;

const hero = bake.hero;
---

<BaseLayout
  title={bake.title}
  description={bake.tagline}
  article={{
    publishedTime: bake.completed,
    section: "Bakes",
    tags: [bake.recipe.title, bake.starter.name],
  }}
>
  <article class="story-page wrap">
    <a class="back-link" href="/bakes/">
      <span aria-hidden="true">←</span> All bakes
    </a>

    <header class="story-header">
      <p class="eyebrow">
        {bake.id.toUpperCase()} · {bake.dateRange}
      </p>

      <h1>{bake.title}</h1>

      <p class="story-intro">
        {bake.tagline}
      </p>

      <dl class="meta-list">
        <div>
          <dt>Recipe</dt>
          <dd>
            <a href={bake.recipe.path}>
              {bake.recipe.title}
            </a>
          </dd>
        </div>

        <div>
          <dt>Starter</dt>
          <dd>
            <a href={bake.starter.path}>
              {bake.starter.name}
            </a>
          </dd>
        </div>

        <div>
          <dt>Rating</dt>
          <dd>{bake.rating}</dd>
        </div>

        {bake.temperature && (
          <div>
            <dt>Finished temp</dt>
            <dd>{bake.temperature}</dd>
          </div>
        )}
      </dl>
    </header>

    {hero && (
      <figure class="story-image story-image-feature">
        <img src={hero.src} alt={hero.caption} />
        <figcaption>{hero.caption}</figcaption>
      </figure>
    )}

    <BakeStory
      story={bake.story}
      photoMap={bake.photoMap}
      galleryMap={bake.galleryMap}
    />

    {(bake.previous || bake.next) && (
      <nav class="bake-navigation" aria-label="Bake navigation">
        {bake.previous ? (
          <a href={bake.previous.route} rel="prev">
            <span>← Previous bake</span>
            <strong>{bake.previous.title}</strong>
          </a>
        ) : <span />}
        {bake.next && (
          <a href={bake.next.route} rel="next">
            <span>Next bake →</span>
            <strong>{bake.next.title}</strong>
          </a>
        )}
      </nav>
    )}
  </article>
</BaseLayout>
