---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact"
  description="Send Bread Pitt your comments, ideas, questions, and wild schemes."
>
  <section class="contact-hero wrap">
    <div class="contact-copy">
      <p class="eyebrow">Come say hello</p>
      <h1>Let&rsquo;s <em>break bread.</em></h1>
      <p class="contact-welcome">
        Comments, ideas, questions, wild schemes—we&rsquo;d love to hear what&rsquo;s on
        your mind. Drop us a note and we&rsquo;ll get back to you soon.
      </p>

      <a class="contact-email" href="mailto:hello@breadpitt.net">
        <span>hello@breadpitt.net</span>
        <span class="contact-arrow" aria-hidden="true">↗</span>
      </a>
      <p class="contact-note">Fresh thoughts are always welcome.</p>
    </div>

    <div class="contact-art" aria-hidden="true">
      <div class="contact-sun"></div>
      <div class="contact-loaf-shadow"></div>
      <div class="contact-loaf">
        <i class="contact-score contact-score-one"></i>
        <i class="contact-score contact-score-two"></i>
        <i class="contact-score contact-score-three"></i>
      </div>
      <i class="contact-crumb contact-crumb-one"></i>
      <i class="contact-crumb contact-crumb-two"></i>
      <i class="contact-crumb contact-crumb-three"></i>
    </div>
  </section>
</BaseLayout>
