---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadBakes } from "../../lib/bakes";

const bakes = (await loadBakes()).reverse();
---

<BaseLayout
  title="Bakes"
  description="Bread Pitt bake records: what happened, what worked, what went wrong, and what I learned."
>
  <section class="page-intro wrap">
    <p class="eyebrow">The bake log</p>
    <h1>Bakes</h1>
    <p>
      The good loaves, the bad loaves, the mistakes, the recoveries, and what I learned from each one.
    </p>
  </section>

  <section class="recipe-index wrap" aria-label="Bake collection">
    {bakes.map((bake) => (
      <article class="recipe-card">
        <a href={bake.route} aria-label={`Open ${bake.title}`}>
          <span class="card-number">{bake.id.replace(/^bake/i, "").padStart(3, "0")}</span>
          <div>
            <p class="card-kind">{bake.recipe.title}</p>
            <h2>{bake.title}</h2>
            <p class="card-subtitle">{bake.dateRange}</p>
            {bake.rating && <p class="card-meta">{bake.rating}</p>}
          </div>
          <span class="card-arrow" aria-hidden="true">↗</span>
        </a>
      </article>
    ))}
  </section>
</BaseLayout>
