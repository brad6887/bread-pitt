---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getRecipeIndexImage, recipes } from "../../data/recipes";
import { loadBakes } from "../../lib/bakes";

const bakes = await loadBakes();
---

<BaseLayout title="Recipes" description="The complete Bread Pitt recipe collection: sourdough loaves, pizza, pitas, rolls, cookies, pancakes, and more.">
  <section class="page-intro wrap">
    <p class="eyebrow">The collected works</p>
    <h1>Recipes</h1>
    <p>Thirteen recovered recipes, reconciled into clean working versions. No ten-page backstory between you and the flour.</p>
  </section>

  <section class="recipe-index wrap" aria-label="Recipe collection">
    {recipes.map((recipe, index) => {
      const relatedBake = bakes.filter((bake) => bake.recipe.slug === recipe.slug).at(-1);
      const indexImage = getRecipeIndexImage(recipe) ?? (relatedBake
        ? { src: relatedBake.hero.src, alt: relatedBake.hero.caption }
        : undefined);

      return <article class="recipe-card">
        <a href={`/recipes/${recipe.slug}/`} aria-label={`Open ${recipe.title}`}>
          <span class="card-number">{String(index + 1).padStart(2, "0")}</span>
          <div>
            <p class="card-kind">{recipe.kind}</p>
            <h2>{recipe.title}</h2>
            {recipe.subtitle && <p class="card-subtitle">{recipe.subtitle}</p>}
            <p class="card-meta">{recipe.meta[0]}</p>
            {indexImage && (
              <img
                class="recipe-card-image"
                src={indexImage.src}
                alt={indexImage.alt}
                width="1500"
                height="2000"
                loading="lazy"
              />
            )}
          </div>
          <span class="card-arrow" aria-hidden="true">↗</span>
        </a>
      </article>;
    })}
  </section>
</BaseLayout>
