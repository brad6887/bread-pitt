---
import BaseLayout from "../layouts/BaseLayout.astro";
import { recipes } from "../data/recipes";
---

<BaseLayout>
  <section class="hero wrap">
    <p class="eyebrow">Starter · Recipes · Bakes</p>
    <h1>Bread Pitt</h1>
    <p class="hero-copy">A growing record of sourdough experiments, observations, and lessons learned—one loaf at a time.</p>
    <div class="hero-actions">
      <a class="button" href="/recipes/">Explore the recipes</a>
      <p>{recipes.length} recovered recipes are ready for their next role.</p>
    </div>
  </section>

  <section class="feature-band">
    <div class="wrap feature-grid">
      <div>
        <p class="eyebrow">Now showing</p>
        <h2>The recipe collection</h2>
      </div>
      <div>
        <p>Clean ingredients, practical methods, and honest notes from the Bread Pitt kitchen.</p>
        <a class="text-link" href="/recipes/">See all {recipes.length} recipes <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
